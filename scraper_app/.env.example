# Scraper worker (scraper_app) configuration.
# Copy to scraper_app/.env on the worker host or inject via the container runtime.

# AWS
AWS_REGION=us-east-1
BUCKET=replace-me-customer-bucket

# Observability (optional)
CUSTOMER=acme-parts
# LOG_LEVEL=INFO
# METRICS_DISABLED=1

# Multi-tenancy (see TENANCY.md)
# Fallback tenant id used when an in-flight SQS message has no tenant_id.
# Required during a single-tenant → multi-tenant cutover.
DEFAULT_TENANT_ID=acme-parts

# Tuning (see PRODUCTION_TUNING.md)
# How many candidate images to download per part. Lower is cheaper
# downstream; 5 is the default. The first US deployment ran at 10 and
# hit OpenAI token ceilings.
# MAX_IMAGES_PER_PART=5
# Which image-search backend to use: bing | duckduckgo
# SEARCH_BACKEND=bing

# SQS queue this worker drains
QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/search_queue

# Microsoft SQL Server
DB_HOST=sql.internal.example.com
DB_PORT=1433
DB_USER=parts_app
DB_PASSWORD=replace-me

# Decodo (or compatible) image-search proxy
DECODO_USERNAME=replace-me
DECODO_PASSWORD=replace-me

# Where the local Tor binary lives (set if not /usr/bin/tor)
TOR_PATH=/usr/bin/tor

# Optional: where to spool temporary files
LOCAL_TMP_DIR=/tmp
